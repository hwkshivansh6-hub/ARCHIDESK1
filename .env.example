# Server Configuration
PORT=3001

# Turso / libSQL Database Credentials
# For cloud persistence on Render, provide your Turso database URL and auth token:
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Cloudinary File Storage Credentials
# For streaming drawing PDFs and site photos to Cloudinary:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
